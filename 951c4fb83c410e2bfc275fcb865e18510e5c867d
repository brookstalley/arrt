ic/screens/health.js", "arrt/src/arrt/http/static/screens/review.js", "arrt/src/arrt/http/static/screens/run.js", "arrt/src/arrt/http/static/screens/settings.js", "arrt/src/arrt/http/static/screens/watches.js", "arrt/src/arrt/library/discovery/engine.py", "arrt/src/arrt/library/discovery/openrouter.py", "arrt/src/arrt/library/discovery/phase_one.py", "arrt/src/arrt/library/services/discovery.py", "arrt/src/arrt/library/services/runner.py", "arrt/src/arrt/library/services/scheduler.py", "arrt/src/arrt/library/services/settings.py", "arrt/src/arrt/library/services/unattended.py", "arrt/src/arrt/library/services/watches.py", "arrt/src/arrt/mcp/bindings.py", "arrt/src/arrt/mcp/tools.py", "arrt/src/arrt/persistence/discovery.py", "arrt/src/arrt/persistence/discovery_records.py", "arrt/src/arrt/persistence/sqlite_discovery.py", "arrt/src/arrt/services/container.py", "arrt/src/arrt/services/health.py", "arrt/tests/browser/conftest.py", "arrt/tests/browser/payloads.py", "arrt/tests/browser/test_component_rules.py", "arrt/tests/browser/test_general_settings.py", "arrt/tests/browser/test_the_settings_index.py", "arrt/tests/browser/test_the_sidebar.py", "arrt/tests/browser/test_watches_screen.py", "arrt/tests/contract/test_mcp_surface.py", "arrt/tests/eval/test_the_driver_runs_a_tool_loop.py", "arrt/tests/integration/test_browser_surface.py", "arrt/tests/integration/test_catalogue_tool.py", "arrt/tests/integration/test_settings_surface.py", "arrt/tests/integration/test_watches_surface.py", "arrt/tests/unit/test_discovery_store.py", "arrt/tests/unit/test_openrouter_client.py", "arrt/tests/unit/test_phase_one_engine.py", "arrt/tests/unit/test_scheduler.py", "arrt/tests/unit/test_settings.py", "arrt/tests/unit/test_source_plugins.py", "arrt/tests/unit/test_surface_parity.py", "arrt/tests/unit/test_watches.py", "tests/preferences/test_screen_tables.py"], "files_oracle": [".prawduct/artifacts/agents-and-memory.md", ".prawduct/artifacts/api-contract.md", ".prawduct/artifacts/build-plan-watches.md", ".prawduct/artifacts/data-model.md", ".prawduct/artifacts/information-architecture.md", ".prawduct/artifacts/observability-strategy.md", ".prawduct/artifacts/re-architecture.md", ".prawduct/artifacts/security-model.md", ".prawduct/changes/watches.md", ".prawduct/project-state.yaml"], "findings": [{"goal": "Nothing Is Broken", "severity": "warning", "title": "A Watch switched on after a long time off, or moved to a shorter cadence, reads as overdue at once and says the scheduler may have stopped", "recommendation": "WatchService.standing computes overdue as `now - due_at > OVERDUE_AFTER`, and due_at comes from last_attempt_at (or created_at if never tried), which a household edit does not move. So a Watch created off two days ago, or one that ran a week ago and was switched off, gets overdue=True the moment update(enabled=True) lands. The same happens when a weekly Watch is changed to hourly. The edit's own response then shows 'Overdue: ... The scheduler may have stopped.' with the fault class, and the status indicator and Status repeat it until the next pass, up to PASS_SECONDS (five minutes) later. A live scheduler gets this wrong. test_a_watch_off_is_never_due_and_one_on_again_is checks due/started but never overdue, and test_overdue_is_an_hour_untried_past_due_whatever_the_cadence only covers a new Watch, so nothing catches it. Fix: count the overdue clock from when the scheduler could first have seen the Watch due, e.g. max(due_at, watch.updated_at). Add a test that turns on a Watch whose due_at is days old and asserts overdue is False, and a re-break check. Scope: class. Search every reader of next_due_at that treats 'due long ago' as 'scheduler dead'. Today that is only standing().overdue.", "files": ["arrt/src/arrt/library/services/watches.py", "arrt/tests/unit/test_scheduler.py", "arrt/tests/unit/test_watches.py"], "fid": "R-1"}, {"goal": "Nothing Is Broken", "severity": "warning", "title": "A household's update rewrites the scheduler's fields from a stale read, so a start recorded mid-edit can be lost and the Watch started twice", "recommendation": "WatchService._record reads and writes inside self._store.transaction(), and its comment says a household edit landing at the same moment is 'neither lost nor overwritten by stale fields'. That only protects one direction. WatchService.update (and delete) runs get() and then update_watch() outside any transaction, and SqliteDiscovery.update_watch writes every column, last_attempt_at/last_run_id/last_refusal included. If record_started lands between update's read and its write, the household's write puts back the old last_run_id and last_attempt_at. On the next pass standing() looks at the old, finished run, so in_flight is False and due_at is in the past, and the Watch starts a second run while the first is still running. That breaks the plan's inferred 'One run per Watch at a time', and the allowance check cannot see the first run's spend because it is not billed yet. The window is small, but this is the code that spends with nobody watching, and its comment claims the protection. Fix: wrap update()'s read-modify-write in self._store.transaction(), the same as _record, or have the household write touch only the household columns. Pin it with a test that runs record_started between update's read and write (for example, a store wrapper whose get_watch triggers it) and asserts last_run_id survives. Scope: instance (update), and check delete for the same shape.", "files": ["arrt/src/arrt/library/services/watches.py", "arrt/src/arrt/persistence/sqlite_discovery.py"], "fid": "R-2"}, {"goal": "Nothing Is Broken", "severity": "warning", "title": "A stored cadence this release does not know makes the scheduler's whole pass and the health reading raise, though the same module defends last_refusal against exactly that", "recommendation": "_sentence deliberately reads last_refusal by value 'never constructed from it: a refusal a later release stored must not make this Watch, or the pass, unreadable'. cadence_of instead calls Cadence(watch.cadence), and that raises ValueError for any value this release lacks (the plan names a finer cadence as a revisit trigger, and the migration is described as one an older release survives). Everything goes through standing(): due(), which fails the whole Watch job's pass, so no Watch runs; reading(), which HealthService.read calls, so /api/health and the status indicator fail; and every list/get on the route and the tool. One downgrade-era row takes out Status as well as every Watch. Fix: treat an unknown stored cadence the way an unknown refusal is treated. Fall back to the household's default, or set it aside with a sentence, and log once. Add a test that seeds an unknown cadence with discovery.update_watch and asserts due(), reading() and the route all still answer. Scope: class. Grep watches.py for every enum built from stored Watch text (Cadence(...), InitiatedBy(...) in _watch) and decide each one.", "files": ["arrt/src/arrt/library/services/watches.py", "arrt/src/arrt/services/health.py"], "fid": "R-3"}, {"goal": "Nothing Is Broken", "severity": "note", "title": "The allowance check prices only this pass's starts, so Watch runs started in an earlier pass and still unbilled are invisible to it", "recommendation": "WatchJob.run_pass starts committed at zero on each pass, and UnattendedAllowance.standing counts only billed SpendRecords. A Watch run started in pass N that has not billed by pass N+1 (PASS_SECONDS later) does not count against another Watch due in pass N+1. Each run is small, and the provider's key limit is the real ceiling. The plan accepts that app-enforced caps fail open on a ledger bug, but this is not a bug, it is the normal state of an in-flight run, and the recorded decision talks only about 'that pass'. Either seed committed from runs the runner is_working_on with watch_id set (or initiated_by=unattended), or record that cross-pass overlap is accepted. Scope: instance.", "files": ["arrt/src/arrt/library/services/scheduler.py"], "fid": "R-4"}, {"goal": "The Design Is Sound", "severity": "warning", "title": "A Watch's stored cadence is constructed, not read by value: one unknown cadence stops every Watch and fails the Watches and Status reads", "recommendation": "Watch holds two enums as text (`cadence`, `last_refusal`), and the service reads them two different ways. `_sentence` reads `last_refusal` by value on purpose. Its comment says a refusal stored by a later release 'must not make this Watch, or the pass, unreadable'. `WatchService.cadence_of` does `Cadence(watch.cadence)` instead, which raises a bare ValueError (not ServiceError) for any value this release does not know: a downgrade after a release adds a cadence, or a hand edit. `standing()` goes through it, and so does every caller: `due()`, so `WatchJob.run_pass` raises and the Scheduler's per-job catch drops the whole pass, which means every Watch stops and not just the bad one; `reading()`, so `GET /api/health` and the status indicator's poll fail; and `GET /api/watches` / `art_watches(action='list')`, which return 500 rather than a refusal. This is the hazard the settings service now handles with SET_ASIDE in the same changeset. Fix: read the cadence by value. On an unknown one, fall back to the household's `unattended_cadence` (or set it aside with a reason, as settings do), and log it once. Pin it with a test that stores an unknown cadence on one of two Watches and checks the other still starts and the list still reads. Scope: instance (the sibling `last_refusal` is already handled; the `InitiatedBy(row[...])` constructions in `_watch` follow the store's existing pattern for every record).", "files": ["arrt/src/arrt/library/services/watches.py", "arrt/src/arrt/library/services/scheduler.py"], "fid": "R-5"}, {"goal": "Everything Is Coherent", "severity": "note", "title": "scheduler.py's module docstring defines overdue as 'due for a whole cadence', which contradicts OVERDUE_AFTER", "recommendation": "The docstring says a Watch is overdue 'when it has been due for a whole cadence with nothing started or refused'. The built rule (`OVERDUE_AFTER`, one hour whatever the cadence), the test `test_overdue_is_an_hour_untried_past_due_whatever_the_cadence`, and the Chunk 04 decision in the plan all say one hour. The constant's own comment sits beside the code, so no maintainer is misled into a wrong edit, which is why this is a NOTE. Remedy: make the clause relational, so it just points at `WatchStanding.overdue` without restating the rule. Scope: instance.", "files": ["arrt/src/arrt/library/services/scheduler.py"], "fid": "R-6"}, {"goal": "The Design Is Sound", "severity": "note", "title": "The Watch projections recompute cadence and cap beside a standing that already carries both", "recommendation": "`api._watch` and `bindings._watch_fields` call `service.standing(watch)` and then also `service.cadence_of(watch)` and `service.effective_cap(watch)`. `WatchStanding` already holds `cadence` and `cap_usd`, computed by the same rules. Each response reads the settings twice, and in principle can report a `effective_cap_usd` that disagrees with the `cap_usd` the standing (and its sentence) used, if a setting changes between the calls. The parity test's stub also has to fake three methods instead of one. Simpler: project from `standing.cadence` and `standing.cap_usd`, so the projection depends on `standing()` alone. Scope: instance (both projections).", "files": ["arrt/src/arrt/http/api.py", "arrt/src/arrt/mcp/bindings.py"], "fid": "R-7"}, {"goal": "The Design Is Sound", "severity": "note", "title": "A Watch's spend scans every spend row of the month, and the new discovery_runs_by_watch index serves no query", "recommendation": "`standing()` calls `spent_by_watch_this_month` (a full scan of the month's spend rows, with a `get_run` per distinct run) and `unattended.standing()` (another full scan) for each Watch. `reading()` runs this for every Watch on every `/api/health` poll, and the list route runs it per Watch per page load. That is harmless at a handful of Watches. The schema's new `discovery_runs_by_watch` index is not used by any query, because spend reaches runs through `get_run` by id. Either drop the index or read a Watch's spend through it (spend rows joined to runs on `watch_id`). Compute the allowance standing once per `reading()`/`due()` rather than once per Watch. Scope: instance.", "files": ["arrt/src/arrt/library/services/watches.py", "arrt/src/arrt/library/services/unattended.py", "arrt/src/arrt/persistence/sqlite_discovery.py"], "fid": "R-8"}, {"goal": "Everything Is Coherent", "severity": "note", "title": "Status's Watches panel writes its own overdue sentence, with the one-hour threshold copied into the client", "recommendation": "The header of `screens/watches.js` says the screen 'composes no verdict of its own' and uses `WatchOut.sentence`. `screens/health.js` writes its own sentence instead: '... is overdue: due for over an hour and not tried'. That copies the `OVERDUE_AFTER` threshold and the wording of `_sentence` into the client. If the constant changes, Status will state the old threshold while Settings \u203a Watches states the new one. Remedy: make the client's line relational ('is overdue: due and not tried') or carry the server's sentence in `WatchesHealthOut`. Scope: instance.", "files": ["arrt/src/arrt/http/static/screens/health.js"], "fid": "R-9"}, {"goal": "Decisions Were Deliberate", "severity": "warning", "title": "The plan's 'Inferred, for the owner to veto (none was ruled)' items reach the merge boundary still unratified", "recommendation": "Scope: instance. It happened because the plan opened with seven inferred choices, and the owner never ruled on any of them before the cumulative review. Two carry weight beyond this branch. (1) 'External identity is not a prerequisite' relaxes re-architecture.md \u00a7 Open questions, 'External identity for works and artists, before Watches'. (2) 'A Watch can be written and changed over MCP' is the path security-model.md \u00a7 The unattended trigger fired accepts as 'weak as prevention': an agent steered by text it read can start standing unattended spend. The others are: one run per Watch at a time; a failed Watch retried within the hour; the estimate taken from phase 1; a new Watch due at once; the screen at Settings \u203a Watches. Chunk 04's PASS_SECONDS is also marked Inferred. Consequence: once this merges, these become the as-built behaviour without anyone having decided them, and a later veto has a release to undo. Before the PR, ask the owner to rule on the list, at least the first two, and record each answer in the plan's Goals. Do not leave the bracket as written.", "files": ["arrt/src/arrt/library/services/watches.py", "arrt/src/arrt/mcp/bindings.py", "arrt/src/arrt/library/services/scheduler.py"], "fid": "R-10"}, {"goal": "Decisions Were Deliberate", "severity": "note", "title": "Mid-build decisions for the owner, with what settled each and the alignment-pass misses", "recommendation": "Scope: none. This is the mandated list, and no edit is wanted. Chunk 03: DELETE /api/watches/{id} instead of POST \u2026/delete (settled by the surface's convention); art_watches is outside ASK_SCOPE (ASK_SCOPE's rule); cadence and last_refusal stored as text (the layering); a cap is refused above the allowance even at $0.00 (the allowance's rule under the budget). Chunk 04: the unattended model is passed per call as WorkListRequest.model ('do it right'); in flight means DiscoveryRunner.is_working_on, not a non-terminal status (found by the suite; ALIGNMENT MISS, 'the goals did not foresee this'); PASS_SECONDS=300 (inferred); could_not_start as a fifth refusal; OVERDUE_AFTER is an hour, not one cadence (found by the Chunk 04 review; alignment miss); each start in a pass is priced on top of what the pass already committed (found by the Chunk 04 review; alignment miss); the estimate uses the discovery model's price (accepted, with a revisit trigger); nothing tests schedule=True in __main__ (recorded; see priors). Chunk 05: Watch spend is on Settings \u203a Watches, not the indicator (the indicator's own rule; the IA was amended); 'found by a Watch' appears on the Get and Review rather than on each card (To review lists runs); Status gains a Watches panel (ALIGNMENT MISS, 'the goals did not foresee this'). priors: R-3 (schedule=True untested through __main__) and R-4 (#178 cited in new code) are accepted, and their cited files have not changed materially, so neither is re-raised.", "fid": "R-11"}, {"goal": "The System Can Be Understood", "severity": "note", "title": "Learnings cross-check: 'When a result gains a collection, write down what bounds it before deciding it needs no cap'. Nothing written bounds the number of Watches", "recommendation": "Scope: instance. It happened because the Watch list was designed as a household-sized set and the number was never written down. surface.md's rule bears on this. api-contract.md gives WatchListOut as 'unpaged'. Nothing caps how many Watches a surface may create, and an MCP agent can create them (security-model.md \u00a7 The unattended trigger fired, item 2). Each Watch's standing() calls spent_in_month, which reads the whole UTC month's spend rows and does a get_run per run. WatchService.reading() then does that for every Watch on each GET /api/health, which the top bar reads on every page. Every scheduler pass does it again through due(). Spend stays bounded by the allowance, but read cost scales with Watch count \u00d7 the month's spend rows, and no bound is stated. One stated bound would close it: either a sentence that a household's Watches are a handful and why that holds over MCP, or a cap on create.", "files": ["arrt/src/arrt/library/services/watches.py", "arrt/src/arrt/library/services/unattended.py", "arrt/src/arrt/services/health.py"], "fid": "R-12"}, {"goal": "Decisions Were Deliberate", "severity": "no