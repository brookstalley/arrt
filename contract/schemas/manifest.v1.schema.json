{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/brookstalley/curatarr/contract/schemas/manifest.v1.schema.json",
  "title": "Wall manifest, major 1",
  "description": "What Curatarr publishes for one wall and Arrt converges on. Major 1 is the document the curation plane writes today (minor 1) plus wave 2's optional media reference (minor 2). The wall is named by the file name or the URL, never inside the document. Semantics the schema cannot carry are in .prawduct/artifacts/player-contract.md.",
  "type": "object",
  "required": [
    "schema",
    "generated_at",
    "theme",
    "rotation",
    "directive",
    "entries"
  ],
  "properties": {
    "schema": {
      "type": "object",
      "required": [
        "major",
        "minor"
      ],
      "properties": {
        "major": {
          "const": 1
        },
        "minor": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "generated_at": {
      "description": "When the document was built, as an RFC 3339 instant with an offset. The pattern is what enforces the offset; 'format' alone is not checked by every validator.",
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "theme": {
      "description": "The theme hanging on the wall. A wall with nothing hanging has no manifest.",
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        }
      }
    },
    "rotation": {
      "type": "object",
      "required": [
        "interval_seconds",
        "shuffle"
      ],
      "properties": {
        "interval_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "shuffle": {
          "type": "boolean"
        }
      }
    },
    "directive": {
      "description": "How show_now and next reach the wall. The Player acts when sequence changes; the rules are in data-model.md § Directive.",
      "type": "object",
      "required": [
        "sequence",
        "pinned_work_id"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "pinned_work_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "entries": {
      "description": "The works the wall may show, in curated order. Membership is readiness: every entry can be rendered.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "required": [
        "work_id",
        "render_path",
        "label"
      ],
      "properties": {
        "work_id": {
          "type": "string",
          "minLength": 1
        },
        "render_path": {
          "description": "The composed render, relative to ART_ROOT. Required throughout major 1, because removing it is a breaking change; a Player on the HTTP channel ignores it and uses media.",
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "^/"
          }
        },
        "media": {
          "description": "Minor 2 (wave 2). The same render, served by the server and addressed by its content.",
          "$ref": "#/$defs/media"
        },
        "label": {
          "$ref": "#/$defs/label"
        }
      }
    },
    "media": {
      "type": "object",
      "required": [
        "url",
        "sha256",
        "bytes",
        "content_type"
      ],
      "properties": {
        "url": {
          "description": "Where to fetch it: a URI reference, resolved against the manifest's own URL. Today the server serves it at /media/sha256-<hex>; after a Library/Programming split it may name the Library's host, and no Player needs to change. The sha256 is the identity: the Player verifies the bytes against it, so a url that disagrees is caught at download and discarded.",
          "type": "string",
          "format": "uri-reference",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "content_type": {
          "enum": [
            "image/jpeg",
            "image/png"
          ]
        }
      }
    },
    "label": {
      "description": "Label text only. How it is set is the Player's decision. The artist's name crosses whole and in parts, because a work whose artist has no recorded parts has only the whole.",
      "type": "object",
      "required": [
        "title",
        "artist",
        "artist_family_name",
        "artist_given_name",
        "artist_nationality",
        "artist_dates",
        "date_created",
        "medium",
        "dimensions",
        "commentary"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "artist": {
          "type": [
            "string",
            "null"
          ]
        },
        "artist_family_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "artist_given_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "artist_nationality": {
          "type": [
            "string",
            "null"
          ]
        },
        "artist_dates": {
          "type": [
            "string",
            "null"
          ]
        },
        "date_created": {
          "type": [
            "string",
            "null"
          ]
        },
        "medium": {
          "type": [
            "string",
            "null"
          ]
        },
        "dimensions": {
          "type": [
            "string",
            "null"
          ]
        },
        "commentary": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
