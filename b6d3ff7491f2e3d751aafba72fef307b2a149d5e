", "arrt/tests/integration/test_startup.py", "arrt/tests/unit/test_artwork_lifecycle.py", "arrt/tests/unit/test_config.py", "arrt/tests/unit/test_dimensions.py", "arrt/tests/unit/test_settings.py", "arrt/tests/unit/test_surface_parity.py", "arrt/tests/unit/test_unattended.py", "tests/preferences/test_example_env_locks_nothing.py", "tests/preferences/test_screen_tables.py"], "files_changed": [".env.example", ".prawduct/artifacts/accessibility-spec.md", ".prawduct/artifacts/agents-and-memory.md", ".prawduct/artifacts/api-contract.md", ".prawduct/artifacts/build-plan-unattended-settings.md", ".prawduct/artifacts/data-model.md", ".prawduct/artifacts/information-architecture.md", ".prawduct/artifacts/nonfunctional-requirements.md", ".prawduct/changes/unattended-settings.md", "arrt/src/arrt/__main__.py", "arrt/src/arrt/config.py", "arrt/src/arrt/http/api.py", "arrt/src/arrt/http/models.py", "arrt/src/arrt/http/pages.py", "arrt/src/arrt/http/static/app.js", "arrt/src/arrt/http/static/screens/general.js", "arrt/src/arrt/http/static/screens/settings.js", "arrt/src/arrt/library/facade.py", "arrt/src/arrt/library/months.py", "arrt/src/arrt/library/services/discovery.py", "arrt/src/arrt/library/services/settings.py", "arrt/src/arrt/library/services/unattended.py", "arrt/src/arrt/mcp/bindings.py", "arrt/src/arrt/mcp/tools.py", "arrt/src/arrt/persistence/discovery.py", "arrt/src/arrt/persistence/discovery_records.py", "arrt/src/arrt/persistence/sqlite_discovery.py", "arrt/src/arrt/services/container.py", "arrt/tests/browser/test_component_rules.py", "arrt/tests/browser/test_general_settings.py", "arrt/tests/browser/test_the_settings_index.py", "arrt/tests/browser/test_the_sidebar.py", "arrt/tests/conftest.py", "arrt/tests/contract/test_mcp_surface.py", "arrt/tests/eval/test_the_driver_runs_a_tool_loop.py", "arrt/tests/integration/test_catalogue_tool.py", "arrt/tests/integration/test_settings_surface.py", "arrt/tests/integration/test_startup.py", "arrt/tests/unit/test_artwork_lifecycle.py", "arrt/tests/unit/test_config.py", "arrt/tests/unit/test_dimensions.py", "arrt/tests/unit/test_settings.py", "arrt/tests/unit/test_surface_parity.py", "arrt/tests/unit/test_unattended.py", "tests/preferences/test_example_env_locks_nothing.py", "tests/preferences/test_screen_tables.py"], "files_oracle": [".prawduct/artifacts/accessibility-spec.md", ".prawduct/artifacts/agents-and-memory.md", ".prawduct/artifacts/api-contract.md", ".prawduct/artifacts/build-plan-unattended-settings.md", ".prawduct/artifacts/data-model.md", ".prawduct/artifacts/information-architecture.md", ".prawduct/artifacts/nonfunctional-requirements.md", ".prawduct/changes/unattended-settings.md"], "findings": [{"goal": "Nothing Is Broken", "severity": "warning", "title": "The allowance's deployment inputs are tested only at the callee: the budget bound and the key fact are unwired-safe at both callers", "recommendation": "Instance. The rule that an allowance may not exceed MONTHLY_BUDGET_USD is tested only by building SettingsService or from_environment with Limits by hand (test_settings.py:212-231, test_unattended.py:123). The two production lines that pass the deployment's budget in are covered by nothing: config.py:595 `_environment_settings(Limits(monthly_budget_usd=monthly_budget_usd))` and container.py:290 `SettingsService(..., limits=Limits(monthly_budget_usd=monthly_budget_usd))`. Change either to `Limits()` and every suite stays green, and the result is that an allowance above the budget is accepted at startup or through the browser and MCP. The same is true of container.py:424 `has_key=key_status is not None`. test_settings_surface.py:103 turns unattended work on and sets an allowance, but it checks only `switched_on` and `allowance_usd`. It never checks `refusal` or `may_start`, so changing the line to `has_key=True` stays green as well. This is the core rule 'When a behaviour matters because something calls or reads it, test through that caller with a non-default value and mutate the lines you changed'. Add three tests through the real callers. First, `Settings.from_env()` with MONTHLY_BUDGET_USD=20 and UNATTENDED_ALLOWANCE_USD=25 raises ConfigError naming the variable. Second, `POST /api/settings/unattended_allowance_usd` above the budget gets a 400 from a Services.bind given monthly_budget_usd. Third, with no key, the route test asserts `refusal == 'no_key'`, and one bound with a key asserts `may_start`. Watch each test fail once against the `Limits()` and `has_key=True` mutations.", "files": ["arrt/src/arrt/config.py", "arrt/src/arrt/services/container.py", "arrt/tests/integration/test_settings_surface.py", "arrt/tests/unit/test_config.py"], "fid": "R-1"}, {"goal": "Nothing Is Missing", "severity": "note", "title": "The Unattended work section has no product verification beyond the browser suite", "recommendation": "Instance. The change note records ux_walk.py reaching Settings \u203a General clean for Chunk 02 only. Chunk 03 added the Unattended work section (four controls, a money field and the standing line), and I found no evidence that the walk was re-run over it or that the plan's verification strategy was carried out (seed an unattended spend row and watch the remaining figure fall). The browser tests in test_general_settings.py:112-141 drive the section in a real browser, which is why this is a NOTE. Re-run `arrt/tools/ux_walk.py` over #general, or record that it was re-run, in the change note.", "files": ["arrt/src/arrt/http/static/screens/general.js"], "fid": "R-2"}, {"goal": "The Design Is Sound", "severity": "note", "title": "Unattended work's 'is there a key' is read off the budget's display probe, not the key", "recommendation": "Instance. `Services.bind` builds `UnattendedAllowance(..., has_key=key_status is not None)`. That reuses `key_status`, which the field comment calls 'Display only: nothing gates on it', as the signal for whether there is a key, and here it gates spend. Today the two agree, because `__main__._key_status` returns None exactly when `OPENROUTER_API_KEY` is unset. But a later change that stops passing the probe (to skip `/key` polling, or in a harness that wires an engine but no probe) would quietly turn unattended work into NO_KEY, with nothing pointing at the cause. Passing `has_key` into `bind` from `settings.openrouter_api_key` (or from the engine's own keyed state) would make the dependency explicit. No change needed this round.", "files": ["arrt/src/arrt/services/container.py"], "fid": "R-3"}, {"goal": "Everything Is Coherent", "severity": "note", "title": "museum-label-findings.md still calls label units the deployment's LABEL_UNITS", "recommendation": "Instance. Prose only, and nothing reads it. `.prawduct/artifacts/museum-label-findings.md` line 81 says 'in the deployment's `LABEL_UNITS`'. Since this change it is the household's `label_units` setting, which `LABEL_UNITS` only locks. The file already defers to `accessibility-spec.md` \u00a7 Dimensions on the label, which this change updated. If it is touched, make the clause relational ('in the household's label units, accessibility-spec.md \u00a7 Dimensions on the label') rather than restating the precedence. No edit wanted for its own sake.", "files": [".prawduct/artifacts/museum-label-findings.md"], "fid": "R-4"}, {"goal": "The System Can Be Understood", "severity": "warning", "title": "A stored choice set aside because it no longer holds reads exactly like a setting nobody chose", "recommendation": "Instance. In SettingsService._state, when a stored value fails `checked` (the plan's own case is an allowance above a MONTHLY_BUDGET_USD lowered since), the state comes back as SettingSource.DEFAULT. That is the same source a setting with no row gets. The only explanation is a log.warning, and it fires again on every describe() and standing() read, so on every Settings \u203a General load. general.js's sourceLine prints nothing for source 'default'. So a household that chose $15.00 sees 'Monthly allowance $0.00' and the sentence 'The monthly allowance for unattended work is $0.00\u2026', with no sign its choice was dropped or why. The API reports the same `source: \"default\"`; only a non-null `updated_at` gives it away, and nothing reads that. The learnings rule applies directly, and it escalated this from a NOTE: 'When a check can be quiet for more than one reason, give each quiet state its own output\u2026'. The fix: give the set-aside state its own SettingSource (or a reason field) carried through SettingOut and the MCP fields, have the screen say in its source line that the stored value no longer holds and why, and pin it with a test on the lowered-budget case (test_unattended.py:123 asserts only the $0.00).", "files": ["arrt/src/arrt/library/services/settings.py", "arrt/src/arrt/http/static/screens/general.js", "arrt/src/arrt/http/api.py", "arrt/src/arrt/mcp/bindings.py"], "fid": "R-5"}, {"goal": "Decisions Were Deliberate", "severity": "note", "title": "scope-trace: cadence, model and standing(estimate) have no production reader yet \u2014 deliberate and recorded", "recommendation": "None. UNATTENDED_CADENCE and UNATTENDED_MODEL are stored and shown, but nothing in arrt/src reads them through SettingsService.value. UnattendedAllowance.standing is called only by GET /api/unattended and art_settings(action='unattended'), and always with the default estimate of 0. The plan records this under 'Tradeoffs accepted' and hands the first reader to the Watches plan ('Revisit if that plan is not written'), so the choice was deliberate and traces to agents-and-memory.md item 4. No edit is wanted. When the Watches plan is written, it should take over that revisit trigger.", "files": ["arrt/src/arrt/library/services/settings.py", "arrt/src/arrt/library/services/unattended.py"], "fid": "R-6"}, {"goal": "Decisions Were Deliberate", "severity": "note", "title": "Mid-build decisions, for the owner", "recommendation": "None. Each mid-build decision and what settled it, from build-plan-unattended-settings.md. Chunk 01: (1) POST rather than PUT, by the surface's own convention. (2) The table sits in the discovery store, by the seam rules. (3) A change is logged rather than written to history_events, because of that table's subject. (4) .env.example no longer sets LABEL_UNITS, because copying it would lock the control; a root test now holds this (test_example_env_locks_nothing.py). Chunk 02: (5) General's place in the index, by the index's own rule, marked inferred. (6) The server-supplied `label`, by 'One word per thing'. Chunk 03: (7) An empty model means the discovery model, settled by 'do it right'. (8) Cadence is a choice and not an interval, marked inferred. (9) On/off is spelled as a choice, by one control per kind. (10) A stored value is checked when read, by 'fails closed'. (11) GET /api/unattended and art_settings(action='unattended'), which the plan needed and did not name. After the cumulative review: (12) the five hardening fixes. Alignment-pass miss: the plan's 'Observability' bullet ('It is also a history_events row if that table's writer fits') was resolved by decision (3), but the bullet was left as written.", "fid": "R-7"}, {"goal": "Decisions Were Deliberate", "severity": "note", "title": "priors: R-9 (inferred goals unruled) acknowledged, not re-raised", "recommendation": "None. Prior disposition R-9 (rev-20261109T185523Z-60216a34, accepted) covers the defaults and the meaning of cadence, which are still under 'Inferred, for the owner to veto'. The environment-lock precedence has since been ruled ('Ruled 2026-11-09', commit be8aff18). Its cited files have not changed materially on that question, so it is not re-raised.", "fid": "R-8"}, {"goal": "Decisions Were Deliberate", "severity": "note", "title": "Learnings Cross-Check", "recommendation": "None. Read core.md, surface.md and tooling.md, the list `learnings-files --for-diff` printed. One rule fired and escalated a finding: 'When a check can be quiet for more than one reason\u2026' (the set-aside stored value, above). 'When you delete a constant or add a required parameter, grep tools/ and scripts/\u2026' was checked: DEFAULT_LABEL_UNITS, Settings.label_units and config._units have no surviving consumer (git grep over the whole tree). 'When you retire, amend\u2026 grep the whole repo\u2026 OLD wording' was checked: museum-label-findings.md:81 still says 'the deployment's LABEL_UNITS'. That is a dated ruling record, still true while the variable sets and locks the setting, and it clears no bar. The diff adds or changes no learnings rule, and none of the corpus supersedes another implicitly.", "fid": "R-9"}, {"goal": "Decisions Were Deliberate", "severity": "note", "title": "Backlog Reconciliation", "recommendation": "None. The cache for brookstalley/arrt (confirmed 6h old) holds 17 open items. `affecting` over the 46 changed paths returned 0 items, and no open item appears resolved by this change. C-B3: the diff moves the UTC month out of DiscoveryService (library/months.py) and adds a second reader of spend (UnattendedAllowance), so it touches the area of open #48 ('architecture: split spend accounting out of DiscoveryService'). Assess #48 and update its body, since spend accounting now has two homes outside DiscoveryService. C-B4: `resolve` says 'unresolved' for #329, which the change fragment closes, and for #177, #178 and #337, which the plan cites. The cache appears to hold open items only, so this most likely means those are closed or uncached rather than dangling. Confirm #329 is the intended close target before merge.", "fid": "R-10"}, {"goal": "Decisions Were Deliberate", "severity": "note", "title": "Records Pass", "recommendation": "None. Covered all 8 oracle files: accessibility-spec.md, agents-and-memory.md, api-contract.md, build-plan-unattended-settings.md, data-model.md, information-architecture.md, nonfunctional-requirements.md and changes/unattended-settings.md. I checked their added claims against the code: the precedence and lock, the $0.00 read of an allowance above a lowered budget, the refusal reasons, UTC month counting, only unattended runs' spend counting, the settings table being additive, .env.example setting nothing, and 'nothing yet runs unattended'. None ships a false claim, misleads into action, or carries a wrong command or config reference. No bar is cleared.", "fid": "R-11"}], "counts": {"blocking": 0, "warning": 2, "note": 9}, "observations": [], "duration_seconds": 540, "scope": "unattended-settings", "scope_chosen_by": "binding", "scope_unresolved_cause": null, "scope_reason": null, "base_extended_from": null, "chunks": [], "chunks_proposed": [], "chunk": null, "base_reviewed": "6da07d6a71dd0ee8820555b711471e97a944c420", "record_lint": {"records": [".prawduct/artifacts/accessibility-spec.md", ".prawduct/artifacts/agents-and-memory.md", ".prawduct/artifacts/api-contract.md", ".prawduct/artifacts/build-plan-unattended-settings.md", ".prawduct/artifacts/data-model.md", ".prawduct/artifacts/information-architecture.md", ".prawduct/artifacts/nonfunctional-requirements.md", ".prawduct/changes/unattended-settings.md"], "chunk_graded": null, "chunks_graded": [], "plan_graded": null, "findings": [], "unchecked": [], "counts": {"chunk-ref-missing": null, "governed-by-gap": 0, "suite-total-claim": 0, "learnings-over-budget": 0, "learnings-budget-unreasoned": 0, "learnings-core-raise-unapproved": 0, "learnings-rule-too-long": 0, "learnings-rule-body": 0, "learnings-area-dead": 0, "change-fragment": 0, "retired-claim-survives": 0}}, "dispatched_at": "2026-11-09T20:03:23Z"}}
