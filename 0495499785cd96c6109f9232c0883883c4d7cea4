ls.py", "arrt/src/arrt/http/static/app.css", "arrt/src/arrt/http/static/core/dates.js", "arrt/src/arrt/http/static/screens/activity.js", "arrt/src/arrt/http/static/screens/walls.js", "arrt/src/arrt/library/facade.py", "arrt/src/arrt/mcp/bindings.py", "arrt/src/arrt/mcp/tools.py", "arrt/src/arrt/persistence/records.py", "arrt/src/arrt/persistence/sqlite.py", "arrt/src/arrt/programming/display.py", "arrt/src/arrt/programming/manifest/v2.py", "arrt/src/arrt/programming/store.py", "arrt/tests/browser/test_hanging_a_theme.py", "arrt/tests/browser/test_scenes_on_walls.py", "arrt/tests/browser/test_the_history.py", "arrt/tests/integration/test_scene_routes.py", "arrt/tests/integration/test_theme_and_display_tools.py", "arrt/tests/unit/test_scenes.py"], "files_oracle": [".prawduct/artifacts/api-contract.md", ".prawduct/artifacts/build-plan-wave-4f-scenes.md", ".prawduct/artifacts/data-model.md", ".prawduct/artifacts/information-architecture.md", ".prawduct/artifacts/re-architecture.md", ".prawduct/change-log.md", ".prawduct/operator-verification.md"], "findings": [{"goal": "Nothing Is Missing", "severity": "warning", "title": "A live scene's pin dropped from the feed still reads as live and 'not shown yet', and allowing or restoring the work never brings it back", "recommendation": "_control_layer drops a live scene's work that has been kept off every wall or archived, which test_a_live_scenes_work_kept_off_every_wall_leaves_the_feed and ..._archived_leaves_the_feed pin. But scene_walls and the live read never consult that verdict. GET /api/scenes/live keeps the wall in the live scene with reached=false, so Walls says '{wall} has not shown it yet' (and the card's sceneLine says 'A scene shows X here'), indefinitely for a hold, about a wall the server has deliberately withdrawn from the scene. The reverse path is also missing. allow_work calls reconcile([id]), and so does a Library restore through its WorkChanged announcement. reconcile asks only about works some feed still carries (mentioned = feed.carried) plus theme members joining. A pinned work that was dropped is in neither set, so the wall is not republished and the scene does not return until some unrelated write (a hang, or the two-day roll). Either have scene_walls report a pin the walls cannot show (judged as _control_layer judges it, from one helper) so the UI says why, or end the pin or scene when it is dropped. In either case, add the allow-again and restore case to reconcile's asked set (works named by live or draft pins) and test it with a non-default sequence: exclude, then allow, then assert the scene is back in the feed. Scope: class. Every reader of the scene (scene_walls, live_scene, sceneLine) should take the drop verdict from the one place that makes it.", "files": ["arrt/src/arrt/programming/display.py", "arrt/src/arrt/http/static/screens/walls.js", "arrt/tests/unit/test_scenes.py"], "fid": "R-1"}, {"goal": "Nothing Is Missing", "severity": "warning", "title": "art_theme scene answers omit ended_at, which the api-contract row gives both surfaces", "recommendation": "The GET /api/scenes/live row says a scene is {scene_id, status, lifetime, starts_at, until, ended_at, walls} and names only work_id->artwork_id as the tool's difference. The MCP binding's _scene_fields leaves out ended_at, while the HTTP _scene includes it. An agent that releases a scene, or reads one that has run out, cannot say when it ended. Add ended_at to _scene_fields (through _moment, as starts_at is) and assert it in test_an_agent_can_show_a_work_per_wall_together_and_release_it after release. Scope: instance. The two field lists are hand-copied, and a check derived from SceneOut's fields would close the class.", "files": ["arrt/src/arrt/mcp/bindings.py", "arrt/tests/integration/test_theme_and_display_tools.py"], "fid": "R-2"}, {"goal": "Nothing Is Broken", "severity": "note", "title": "apply_scene has no upper bound on minutes; an overflowing length is a 500, not a refusal in words", "recommendation": "ApplyScene.minutes is an unbounded int, and the MCP Param sets only minimum=1. apply_scene checks only length <= 0, so a value large enough to overflow (now + timedelta(minutes=~5e9) passes year 9999) raises OverflowError inside the transaction. Only ServiceError has an exception handler (app.py), so HTTP answers 500 and MCP returns an unworded error. The UI offers only 5/20/60, so only API and agent callers reach this. Refuse a length above a stated ceiling with a ServiceError, and add a case to test_a_lifetime_that_cannot_be_applied_is_refused_and_the_draft_stays. Scope: instance.", "files": ["arrt/src/arrt/programming/display.py", "arrt/src/arrt/http/models.py"], "fid": "R-3"}, {"goal": "Nothing Is Unintended", "severity": "note", "title": "A preview's 'expired' journal line is logged inside a transaction that a later refusal rolls back", "recommendation": "_end calls _log_scene before its transaction commits. In release_scene and apply_scene, _settle_scenes runs first, and a refusal after it rolls the write back: releasing a preview that has just run out, or an apply refused for a pin. The journal then says 'Scene X: ran out at ...' for a write that never landed, and says it again at the next settle that does commit. This is the class chunk 01's review fixed under 'honest journal lines'. Defer the line to after commit (beside _record_ended), or settle in its own transaction before the act's. Scope: instance (all three _end callers go through it).", "files": ["arrt/src/arrt/programming/display.py"], "fid": "R-4"}, {"goal": "Nothing Is Broken", "severity": "note", "title": "History's 'ran_out' sentence has no browser test", "recommendation": "test_a_scene_reads_as_applied_and_ended_on_its_wall parametrises over release and replace only. SCENE_ENDINGS.ran_out ('Time ran out on') is the ending the owner will actually meet after every preview, and nothing renders it, so a typo in its key would silently fall back to 'Ended'. Add a third case that records a ran_out end (a preview settled by a heartbeat, as test_a_heartbeat_writes_down_that_a_preview_ran_out does) and asserts the sentence. Scope: instance.", "files": ["arrt/tests/browser/test_the_history.py", "arrt/src/arrt/http/static/screens/activity.js"], "fid": "R-5"}, {"goal": "Everything Is Coherent", "severity": "warning", "title": "MCP scene projection drops ended_at, which the contract and the HTTP twin carry, and the pair is not in the surface-parity check", "recommendation": "Scope: instance, with a bounded class. The api-contract row for GET /api/scenes/live / art_theme(action='scenes') says a scene is {scene_id, status, lifetime, starts_at, until, ended_at, walls} on both surfaces, and names only work_id->artwork_id as the difference. HTTP `_scene` (api.py) emits ended_at; MCP `_scene_fields` (bindings.py) does not. So an agent that runs release_scene, or reads a preview that has run out, gets status 'ended' with no time, while a click gets one. http/models.py's own rule ('Field names match the MCP surface wherever both carry the same fact') is enforced by tests/unit/test_surface_parity.py's check_parity, but only for pairs someone added by hand, and neither SceneOut/_scene_fields nor SceneWallOut/the wall dict was added. Fix: add ended_at to `_scene_fields`. Then add both pairs to check_parity, with work_id->artwork_id as the declared exemption, so that dropping a field in either projection fails. To find other members, check every *Out model added in this diff that has an MCP twin. In this diff those are the scene models only.", "files": ["arrt/src/arrt/mcp/bindings.py", "arrt/src/arrt/http/api.py", "arrt/src/arrt/http/models.py"], "fid": "R-6"}, {"goal": "Everything Is Coherent", "severity": "warning", "title": "Scene section focus keys disagree with what paintScene can find: Discard asks for 'scene-title', which no element carries", "recommendation": "Scope: instance. paintScene focuses `[data-scene-focus=\"${focus}\"]`. Discard's `then` passes \"scene-title\", but the h2 has only id=\"scene-title\". It has no data-scene-focus attribute, and no tabindex=-1 to make it focusable. So after Discard the button that held focus is removed and focus falls to <body>. A keyboard or screen-reader user loses their place, which is what the focus parameter was added to prevent. The opposite mismatch also exists: the Release button carries data-scene-focus=\"release\", but no caller ever asks for it. The paintScene doc comment says that after Apply or Release the section 'repaints only itself, so focus stays where the curator left it'. In fact Release calls refresh() (the whole page), and watchScene starts with refresh(). Fix: give the heading data-scene-focus=\"scene-title\" and tabindex=\"-1\" (or pass an existing key). Remove the unused 'release' key. Make the comment describe what the code actually does (delete the claim or make it relational, not reworded history). The browser test for Discard (test_discard_forgets_the_picks) could check document.activeElement after the click to keep this fixed.", "files": ["arrt/src/arrt/http/static/screens/walls.js"], "fid": "R-7"}, {"goal": "The Design Is Sound", "severity": "note", "title": "How a scene ended is a bare-string vocabulary spread across five sites with no owning type", "recommendation": "Scope: instance. 'released' | 'replaced' | 'ran_out' is written as a string in `_end` (also used to choose the log event, where 'replaced' is logged as scene.released), passed to `_record_ended`, matched in apply_scene's `how == \"replaced\"` filter (which decides which ended walls get republished), stored in History detail, and read by activity.js's SCENE_ENDINGS. Everywhere else, scene state is a StrEnum in records.py (SceneStatus, SceneLifetime, EventKind). A typo at the apply filter would leave a replaced hold's walls still showing it, and no type would catch that. A `SceneEnding` StrEnum next to SceneLifetime (and the `_Ended` alias typed with it) would give the vocabulary one owner. It could also carry the log event name, so a replacement is no longer logged as scene.released.", "files": ["arrt/src/arrt/programming/display.py", "arrt/src/arrt/persistence/records.py"], "fid": "R-8"}, {"goal": "Everything Is Coherent", "severity": "note", "title": "SceneLifetime docstring cites a build plan by path", "recommendation": "Scope: class, bounded. records.py's SceneLifetime says 'Keep is not built (`build-plan-wave-4f-scenes.md`)'. Plans get archived, which leaves path citations pointing at nothing. The fact that keep is deferred is already in data-model.md's scenes entry ('built less keep') and in the plan's scope. Point at the artifact that outlives the plan (data-model.md, or player-contract.md \u00a7 Scenes), or drop the parenthetical. `git grep -n build-plan- arrt/src` finds 13 older members of this shape. Those are out of this diff's scope, and this is not a request to edit them.", "files": ["arrt/src/arrt/persistence/records.py"], "fid": "R-9"}, {"goal": "The System Can Be Understood", "severity": "warning", "title": "A 'Time ran out' History line is stamped when the server notices, not when the preview ended", "recommendation": "Instance. `_settle_scenes` ends a run-out preview with `ended_at=scene.until`, but `_record_ended` passes only `how` into the detail, and `CatalogueService.record_event` writes every line 'now'. So the `scene.ended`/`ran_out` line carries the time of the next settle: the next heartbeat or scene act. With walls heartbeating that is seconds. When the server was down it is the restart, and Chunk 03's 'The server gone' step does exactly that. An operator reading History to answer 'why did the wall change' then sees the scene end at a time neither wall changed. Fix: put the end instant in the detail for a run-out (e.g. `ended_at=_iso(scene.ended_at)`) and have `activity.js` say 'Time ran out at {readable}'. Or record the line only for released/replaced and let History derive run-outs. Pin it with a test that settles a preview whose `until` is well in the past and asserts the rendered time.", "files": ["arrt/src/arrt/programming/display.py", "arrt/src/arrt/http/static/screens/activity.js"], "fid": "R-10"}, {"goal": "Decisions Were Deliberate", "severity": "warning", "title": "Records Pass: the plan's Status still shows Chunk 01 open, and the dispatch tooling graded the wrong chunk because of it", "recommendation": "Instance. `build-plan-wave-4f-scenes.md` \u00a7 Status has `[ ] Chunk 01` unticked. Chunk 01 was committed after its review ('Wave 4f chunk 01, after its review', ee35989b), and the plan's own mid-build list records '01, after its review' decisions. `plan_status.current_chunks` reads that block, and this dispatch's `record_lint.unchecked` shows the consequence: it inferred chunk 01 as the graded chunk, so the chunk-ref check ran against 01 rather than 02. That clears the 'misleads into action' bar, because tooling reading the record did the wrong thing. Tick Chunk 01 now, and Chunk 02 once this review is dispositioned, in the commit already carrying the review's outcome.", "files": [".prawduct/artifacts/build-plan-wave-4f-scenes.md"], "fid": "R-11"}, {"goal": "The System Can Be Understood", "severity": "note", "title": "A replaced scene is journalled under the `scene.released` event", "recommendation": "Instance. `_end` logs `\"expired\" if how == \"ran_out\" else \"released\"`, so a replacement goes to the journal as event `scene.released` with the words 'replaced by scene \u2026'. History tells released from replaced, but a journal filter on the structured event cannot. If it is cheap, log `scene.replaced` (or put `how` in `extra`). The words already disambiguate for a human reader, so no edit is required.", "files": ["arrt/src/arrt/programming/display.py"], "fid": "R-12"}, {"goal": "Decisions Were Deliberate", "severity": "note", "title": "Mid-build decisions of wave 4f, for the owner", "recommendation": "Scope: none. Recorded with what settled each, and checked against the code. (1) Keep deferred: `[DECISION]` in the plan, SceneLifetime has no keep. (2) Control layer derived at every write through one funnel, `_publish_feed`: `[DECISION]`, and the code matches. (3) Every act patches rather than rebuilds walls: settled by the plan's scene-end goal. (4) `Published.works` now means the schedule's works only, with `control_works`/`carried` beside it: the docstring says so, and grep finds no `Published` consumer outside `display.py`. (5) Withdrawal, reconciliation and showings read `carried`. (6) Scene tools on `art_theme`, not `art_display`: the 2 KB description budget, also recorded in api-contract.md. (7) History kinds `scene.applied`/`scene.ended` moved from 01 to 02, flagged as an alignment-pass miss. (8) Pin refused for a wall with no feed: inferred, the plan was silent. (9) The data-model Scene entry was marked built at 01 rather than 03. (10) The move of scenes out of DisplayService is filed as brookstalley/arrt#382, not done. Downstream consumer impact (the Player reading `scene`/`staging`) was investigated: an end-to-end run against the real Player loops with doubles is recorded in change-log.md. No new dependency. Goals are owner-answered except keep, which the builder decided and flagged vetoable.", "files": [".prawduct/artifacts/build-plan-wave-4f-scenes.md"], "fid": "R-13"}, {"goal": "Decisions Were Deliberate", "severity": "note", "title": "Learnings Cross-Check: no regression against core.md or surface.md", "recommendation": "Scope: none. Read `.claude/rules/learnings/core.md` and `surface.md` (the list `learnings-files --for-diff` printed). Rules checked against the change, all conforming. 'When a result gains a collection, write down what bounds it': data-model.md's Scene Retention paragraph names the bound and the `scenes_by_status` index, and the index exists in sqlite.py. 'When you write or cite 'exactly one', 'always' or 'never', state what the store or guard actually enforces': 'one draft at a time' is stated as a UI hold the store does not enforce, and 'a wall appears at most once in a scene' is the `scene_pins` primary key. 'When code is added, moved or retired, ask which guards were scoped to the old shape': withdrawal, reconciliation and showings were widened from `works` to `carried`. 'Before a UI or notice says 'do X to fix this', grep for the endpoint': 'Hang a theme there first' and 'Allow it again from its page' both have controls. No learnings were added or changed this cycle.", "fid": "R-14"}, {"goal": "Decisions Were Deliberate", "severity": "note", "title": "Backlog Reconciliation: nothing resolved; cited ids all resolve", "recommendation": "Scope: none. `cache-query affecting` over the changed files returned arrt#126, #135, #143, #145, #204, #376 and #382. None is resolved by this branch: #382, moving scenes out of DisplayService, was filed during this work and is deliberately open. C-B4: #216, #309 and #382, cited in the plan and the records, all resolve as open. C-B3: #216's update for the two new tables was already accepted in the prior review (priors, below). The cache reports confirmed 2026-09-30, although it carries items created 2026-10-26. If that age matters, run `prawduct-hook backlog sync --repo brookstalley/samsung-frame-art-loader`. priors: R-2 (#216 learns about scenes/scene_pins/scenes_by_status) was accepted, with no material change in sqlite.py since, so it is not re-raised.", "fid": "R-15"}, {"goal": "Decisions Were Deliberate", "severity": "note", "title": "Records Pass: oracle set covered, nothing else clears a bar", "recommendation": "Scope: none. Covered: api-contract.md, build-plan-wave-4f-scenes.md, data-model.md, information-architecture.md, re-architecture.md, change-log.md and operator-verification.md. Spot-checked against the code: the route rows (400 for a wall with no feed, 20-minute default, discard answers differ by surface), the EventKind detail fields, the `scenes_by_status` index, and the operator-verification wording ('{wall}