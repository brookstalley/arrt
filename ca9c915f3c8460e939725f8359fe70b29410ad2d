{"schema": 1, "kind": "review", "id": "rev-20261109T185523Z-60216a34", "ts": "2026-11-09T18:59:50Z", "actor": {"worktree": "arrt", "plugin": "3.8.1-dev", "branch": "feature/unattended-settings", "build": "52bb14851a37"}, "body": {"base_commit": "06a456f61babbd88be886fe73d347f30c0e83e90", "base_tree": "c21ba3f638122be16a01c121875b4f75c59c43be", "head_tree": "eb5fbb15671d6e2ee33cb0b983666408173de7ac", "head_commit": "ca9c915f3c8460e939725f8359fe70b29410ad2d", "dispatch_commit": "ca9c915f3c8460e939725f8359fe70b29410ad2d", "mode": "cumulative (bundle review, ready for merge)", "mode_chosen_by": "explicit-args", "stage": "boundary", "tier": "escalate", "roster": [{"role": "correctness", "model": "claude-opus-5-5"}, {"role": "design", "model": "claude-opus-5-5"}, {"role": "sustainability", "model": "claude-opus-5-5"}], "files_reviewed": [".env.example", "arrt/src/arrt/__main__.py", "arrt/src/arrt/config.py", "arrt/src/arrt/http/api.py", "arrt/src/arrt/http/models.py", "arrt/src/arrt/http/pages.py", "arrt/src/arrt/http/static/app.js", "arrt/src/arrt/http/static/screens/general.js", "arrt/src/arrt/http/static/screens/settings.js", "arrt/src/arrt/library/facade.py", "arrt/src/arrt/library/services/settings.py", "arrt/src/arrt/library/services/unattended.py", "arrt/src/arrt/mcp/bindings.py", "arrt/src/arrt/mcp/tools.py", "arrt/src/arrt/persistence/discovery.py", "arrt/src/arrt/persistence/discovery_records.py", "arrt/src/arrt/persistence/sqlite_discovery.py", "arrt/src/arrt/services/container.py", "arrt/tests/browser/test_component_rules.py", "arrt/tests/browser/test_general_settings.py", "arrt/tests/browser/test_the_settings_index.py", "arrt/tests/browser/test_the_sidebar.py", "arrt/tests/conftest.py", "arrt/tests/contract/test_mcp_surface.py", "arrt/tests/eval/test_the_driver_runs_a_tool_loop.py", "arrt/tests/integration/test_catalogue_tool.py", "arrt/tests/integration/test_settings_surface.py", "arrt/tests/integration/test_startup.py", "arrt/tests/unit/test_artwork_lifecycle.py", "arrt/tests/unit/test_config.py", "arrt/tests/unit/test_dimensions.py", "arrt/tests/unit/test_settings.py", "arrt/tests/unit/test_surface_parity.py", "arrt/tests/unit/test_unattended.py", "tests/preferences/test_example_env_locks_nothing.py", "tests/preferences/test_screen_tables.py"], "files_changed": [".env.example", ".prawduct/artifacts/accessibility-spec.md", ".prawduct/artifacts/agents-and-memory.md", ".prawduct/artifacts/api-contract.md", ".prawduct/artifacts/build-plan-unattended-settings.md", ".prawduct/artifacts/data-model.md", ".prawduct/artifacts/information-architecture.md", ".prawduct/artifacts/nonfunctional-requirements.md", ".prawduct/changes/unattended-settings.md", "arrt/src/arrt/__main__.py", "arrt/src/arrt/config.py", "arrt/src/arrt/http/api.py", "arrt/src/arrt/http/models.py", "arrt/src/arrt/http/pages.py", "arrt/src/arrt/http/static/app.js", "arrt/src/arrt/http/static/screens/general.js", "arrt/src/arrt/http/static/screens/settings.js", "arrt/src/arrt/library/facade.py", "arrt/src/arrt/library/services/settings.py", "arrt/src/arrt/library/services/unattended.py", "arrt/src/arrt/mcp/bindings.py", "arrt/src/arrt/mcp/tools.py", "arrt/src/arrt/persistence/discovery.py", "arrt/src/arrt/persistence/discovery_records.py", "arrt/src/arrt/persistence/sqlite_discovery.py", "arrt/src/arrt/services/container.py", "arrt/tests/browser/test_component_rules.py", "arrt/tests/browser/test_general_settings.py", "arrt/tests/browser/test_the_settings_index.py", "arrt/tests/browser/test_the_sidebar.py", "arrt/tests/conftest.py", "arrt/tests/contract/test_mcp_surface.py", "arrt/tests/eval/test_the_driver_runs_a_tool_loop.py", "arrt/tests/integration/test_catalogue_tool.py", "arrt/tests/integration/test_settings_surface.py", "arrt/tests/integration/test_startup.py", "arrt/tests/unit/test_artwork_lifecycle.py", "arrt/tests/unit/test_config.py", "arrt/tests/unit/test_dimensions.py", "arrt/tests/unit/test_settings.py", "arrt/tests/unit/test_surface_parity.py", "arrt/tests/unit/test_unattended.py", "tests/preferences/test_example_env_locks_nothing.py", "tests/preferences/test_screen_tables.py"], "files_oracle": [".prawduct/artifacts/accessibility-spec.md", ".prawduct/artifacts/agents-and-memory.md", ".prawduct/artifacts/api-contract.md", ".prawduct/artifacts/build-plan-unattended-settings.md", ".prawduct/artifacts/data-model.md", ".prawduct/artifacts/information-architecture.md", ".prawduct/artifacts/nonfunctional-requirements.md", ".prawduct/changes/unattended-settings.md"], "findings": [{"goal": "Nothing Is Broken", "severity": "warning", "title": "An allowance spent to the cent still reports may_start when no estimate is given", "recommendation": "Instance. UnattendedAllowance.standing refuses only when `spent + estimate_usd > allowance`, and estimate_usd defaults to 0. Once spent equals the allowance (the case test_a_piece_that_would_pass_the_allowance_is_refused_and_one_that_fits_may_start sets up: 4.98 + 0.02 of 5.00), standing() and GET /api/unattended still return may_start=true and the sentence 'Unattended work may run: $5.00 of this month's $5.00 is spent.' Nothing remains, but work is allowed to start. That contradicts the setting's own description ('Work stops starting once it is spent') and the allowance==0 branch, which refuses everything at zero remaining. The plan's Done-when says the Watches caller uses `may_start` 'with nothing more built', so it will most likely call with no estimate and hit this. Fix: refuse when remaining_usd is 0, i.e. `spent >= allowance` whatever the estimate, while still allowing an estimate that lands exactly on the allowance when something remains. Pin it with a test at spent == allowance and estimate 0, asserting both the refusal and the sentence. Per the learning 'When a clause or notice is conditional, assert its absence in the case where it must not appear', the 'may run' sentence should be asserted absent there.", "files": ["arrt/src/arrt/library/services/unattended.py", "arrt/tests/unit/test_unattended.py"], "fid": "R-1"}, {"goal": "Nothing Is Broken", "severity": "warning", "title": "A large allowance amount escapes as a bare decimal.InvalidOperation instead of a refusal by name", "recommendation": "Instance, plus a bounded class. In settings._money, only `Decimal(text)` is inside the try. `amount.quantize(Decimal('0.01'))` signals InvalidOperation once the result needs more digits than the context's precision of 28. Any value of about 1e26 or more does this, e.g. '1e30', or a 30-digit integer. Note that `_within_the_budget` runs after parse, so a deployment budget does not stop it. Through POST /api/settings/unattended_allowance_usd that is a 500 rather than a 400 in the service's words. Over MCP it reaches the tool boundary as 'failed unexpectedly', which is the outcome the codebase explicitly guards against in DiscoveryService.spend_in_month. Given as UNATTENDED_ALLOWANCE_USD in the environment, it is a startup traceback instead of the ConfigError `_environment_settings` promises. A related slip: '-0' passes `amount < 0` and is stored and shown as '-0.00' ('$-0.00' on the screen). Fix: put the quantize (and a sane upper bound) inside the refusal path so it raises SettingRefused, normalise negative zero, and add both to test_an_allowance_that_is_not_an_amount_is_refused_by_name. To bound the class, check every Decimal parser in the diff's reach for operations after construction that can signal. config._priced has the same shape for MONTHLY_BUDGET_USD='NaN' (`value < 0` signals on NaN), and that value now feeds Limits.", "files": ["arrt/src/arrt/library/services/settings.py", "arrt/tests/unit/test_settings.py", "arrt/src/arrt/config.py"], "fid": "R-2"}, {"goal": "Nothing Is Missing", "severity": "note", "title": "The Unattended work section shows the month's spend only in some states, and never the remaining figure", "recommendation": "Instance. Chunk 03 asks that the section show 'what it has spent this month against the allowance'. The plan's verification step is to 'see the allowance's remaining figure fall'. general.js renders only `unattended.sentence`. When work is off, when there is no key, or when the allowance is $0.00, that sentence carries no spend figure. So spend recorded before a household switched off, or before it lowered the allowance to 0, is invisible on the screen. remaining_usd is computed and served but no client reads it. Either render spent of allowance and remaining beside the sentence in every state, or record that the sentence is the chosen display and amend the verification step.", "files": ["arrt/src/arrt/http/static/screens/general.js"], "fid": "R-3"}, {"goal": "Nothing Is Missing", "severity": "note", "title": "Cadence and model are stored and served, but nothing reads them, and the accepted tradeoff names only the allowance check", "recommendation": "Instance. unattended_cadence and unattended_model have no reader outside the settings surfaces. The plan's 'Tradeoffs accepted' records only that the allowance check has no caller until Watches. Extend that line to name these two settings as waiting for the same consumer, with the same revisit trigger, so that a Watches plan never written does not leave two controls that change nothing.", "files": ["arrt/src/arrt/library/services/settings.py"], "fid": "R-4"}, {"goal": "The Design Is Sound", "severity": "warning", "title": "Each setting's environment variable is written twice, once in its declaration and again by hand in its parser's refusal text", "recommendation": "Class, bounded to library/services/settings.py. The module says every setting is 'declared once', but each declaration names its variable in `environment_variable` and then again inside its parser: `_choice(Units, \"LABEL_UNITS\")`, `_choice(Switch, \"UNATTENDED_WORK\")`, `_choice(Cadence, \"UNATTENDED_CADENCE\")`, `_money(\"UNATTENDED_ALLOWANCE_USD\")`, `_model`'s literal 'UNATTENDED_MODEL', and `_within_the_budget`, which looks generic but hard-codes 'UNATTENDED_ALLOWANCE_USD'. The two copies can drift apart. Rename a variable, or reuse `_money` or `_within_the_budget` for a second amount, and the refusal (shown in the browser, over MCP and at startup) names a variable that does not exist or is the wrong one. A curator or operator then goes looking for it in .env. Fix it with one owner: parsers and checks raise `SettingRefused` without a name, and `Setting.checked` prefixes `self.environment_variable` (or the label, if a browser refusal should name the control). The existing refusal tests then hold the wording unchanged.", "files": ["arrt/src/arrt/library/services/settings.py"], "fid": "R-5"}, {"goal": "The Design Is Sound", "severity": "warning", "title": "The UTC calendar-month window is copied from DiscoveryService.spend_in_month into UnattendedAllowance, `_DECEMBER` constant included", "recommendation": "Instance. `UnattendedAllowance.spent_this_month` (unattended.py:80-82) computes `since`/`until` with the same expression as `DiscoveryService.spend_in_month` (discovery.py:1399-1400) and declares its own `_DECEMBER = 12`. The plan's constraint says the allowance's month must match that method ('The month is UTC's, matching the provider's reset (`DiscoveryService.spend_in_month`)'), but nothing ties the two together. If one boundary changes, the allowance sums a different window from `art_discovery(action='spend')` and the Status spend record, and a household sees two different 'this month' figures. Extract one month-bounds helper, for example `utc_month_bounds(year, month) -> (since, until)`, and have both call it.", "files": ["arrt/src/arrt/library/services/unattended.py"], "fid": "R-6"}, {"goal": "The Design Is Sound", "severity": "note", "title": "Setting.kind and Setting.choices are independent fields with an invariant nothing enforces", "recommendation": "Class, bounded to the SETTINGS declarations. Nothing stops a declaration with `kind=CHOICE` and empty `choices`: `kind` defaults to CHOICE, and `choices` is passed separately from the enum its parser reads. general.js would then draw an empty picker. Each choice setting also repeats `choices=tuple(str(m) for m in E), parse=_choice(E, ...), render=str`. A `__post_init__` check, or a small choice-setting constructor that derives choices, parse and kind from one enum, would make the bad combination impossible to write. All five declarations are correct today, so this is not urgent.", "files": ["arrt/src/arrt/library/services/settings.py"], "fid": "R-7"}, {"goal": "The Design Is Sound", "severity": "note", "title": "The client places the unattended standing line by hard-coding the key 'unattended_work', while sections are otherwise the server's", "recommendation": "Instance. general.js says the settings' sections come from the server, so a new setting needs no client edit. But `section()` decides where the `/api/unattended` sentence goes by `members.some(key === 'unattended_work')`. If that key is renamed, or the setting moves to another section, the standing line silently disappears. The browser suite should catch that if it asserts the line. Matching on the section name the server sends (`UNATTENDED_SECTION`) would put the coupling on the field that actually carries it. No change is wanted if the current coupling is preferred.", "files": ["arrt/src/arrt/http/static/screens/general.js"], "fid": "R-8"}, {"goal": "Decisions Were Deliberate", "severity": "warning", "title": "The plan's inferred goals are still unruled at the boundary: environment-locks precedence, the defaults, and what cadence means", "recommendation": "Instance. The build plan's Goals still carry 'Inferred, for the owner to veto (none was ruled)': (1) the environment wins and locks the control, (2) the defaults (off, $0.00, daily, discovery model, allowance capped at MONTHLY_BUDGET_USD), (3) cadence as the longest a Watch goes between runs. Level is Medium, and the plan names the step that would raise it: the owner confirming that the environment locks the control. That step was never taken. The behaviour now ships. The change record's Consumer note tells every installation that a LABEL_UNITS in its env file now locks the control. Every installation that copied the old .env.example has LABEL_UNITS=imperial uncommented, so on upgrade every one of them gets a locked Label units control. If the owner vetoes the precedence after merge, the consumer note and the shipped behaviour both have to be reversed. Before merging, get the ruling on (1), at least, and record it in the plan's Goals with its date.", "files": ["arrt/src/arrt/library/services/settings.py", ".env.example"], "fid": "R-9"}, {"goal": "Decisions Were Deliberate", "severity": "note", "title": "Mid-build decisions, for the owner, and two places the plan's Chunk 03 text no longer matches what was built", "recommendation": "Scope none, for the owner. Mid-build decisions and what settled each: Chunk 01: POST not PUT (the surface's convention); the table in SqliteDiscovery (the seam rules); changes logged, not written to history_events (that table's subject); .env.example stops setting LABEL_UNITS (found during the build, held by a root test). Chunk 02: General placed after Sources (the index's own rule, inferred); labels come from the server ('One word per thing'). Chunk 03: empty model means the discovery model ('do it right'); cadence is a choice, not an interval (inferred); on/off is a choice ('one control per kind'); a stored value that breaks a rule reads as the default ('fails closed'); GET /api/unattended and art_settings(action='unattended') added to give the standing. Alignment misses, none of them in the decision list: Chunk 03 specifies keys `unattended_enabled` and `unattended_monthly_allowance_usd`, but `unattended_work` and `unattended_allowance_usd` were built. It also specifies `may_start(estimate)` as a method, but what was built is `standing(estimate)` returning a `Standing`, with `may_start` as a property. Done-when says 'the Watches plan can call `may_start`'. Whoever writes the Watches plan from this one should cite `UnattendedAllowance.standing(estimate).may_start` and the built keys.", "files": ["arrt/src/arrt/library/services/unattended.py", "arrt/src/arrt/library/services/settings.py"], "fid": "R-10"}, {"goal": "Decisions Were Deliberate", "severity": "note", "title": "scope-trace: the cadence and model settings are stored, shown and editable, and nothing reads their values", "recommendation": "Class, bounded to `UNATTENDED_CADENCE` and `UNATTENDED_MODEL`: outside settings.py, no code calls `settings.value()` on either (grep of arrt/src and arrt/tools). Both trace to agents-and-memory item 4, so their parent is real. But the plan's recorded tradeoff ('The allowance check has no caller until the Watches plan \u2026 Revisit if that plan is not written') covers only the allowance. The change record's 'Nothing starts unattended work yet' is the only mention of the other two. Nothing goes wrong today because nothing runs. If the Watches plan does not read them, a household's chosen model and cadence are ignored without a word. Extend the tradeoff's revisit trigger to name both settings, so the Watches plan inherits them as consumers it owes.", "files": ["arrt/src/arrt/library/services/settings.py"], "fid": "R-11"}, {"goal": "The System Can Be Understood", "severity": "note", "title": "A stored value that no longer holds is visible only in a warning repeated on every read; the API reports it as 'default' while keeping the stored row's updated_at/updated_by", "recommendation": "Instance (SettingsService._state). Say a household's stored allowance is above a budget that was later lowered. Failing closed to the default is the recorded decision, and that part is right. Two things make the state hard to see. First, `log.warning` fires on every `_state` call, so every describe(), standing() and GET /api/unattended logs it again, and for label_units every playable() and labels() call would too. Second, the screen gets `source: default`, so it shows no source line, while `updated_at` and `updated_by` still carry the discarded row's values. The household sees $0.00 and gets no hint that their choice was set aside. If this deserves a fix, give the state a value of its own (for example a distinct source) that the screen can state in words, so the household is told on the page rather than only the log being told on every read.", "files": ["arrt/src/arrt/library/services/settings.py", "arrt/src/arrt/http/static/screens/general.js"], "fid": "R-12"}, {"goal": "The System Can Be Understood", "severity": "note", "title": "InitiatedBy.UNATTENDED's comment says 'nothing else reads it', and other code does read it", "recommendation": "Instance. Learnings rule 'When you write a negative claim, run the search that would have falsified it.' Grepping `initiated_by` shows runner.py logging it (lines 707, 775, 813), and the API and MCP run views returning it (api.py:2528, bindings.py:2161). The true and load-bearing claim is narrower, and unattended.py's docstring already states it: nothing *branches* on it except the allowance sum. Either delete the clause or make it that narrower claim. No other edit is wanted.", "files": ["arrt/src/arrt/persistence/discovery_records.py"], "fid": "R-13"}, {"goal": "The System Can Be Understood", "severity": "note", "title": "Learnings Cross-Check: rules applied to this change; one regression, already filed above", "recommendation": "Scope none. Read list from `learnings-files --for-diff`: core.md, surface.md, tooling.md. 'When you delete a constant or add a required parameter, grep `tools/` and `scripts/`': DEFAULT_LABEL_UNITS, Settings.label_units and Services.bind(label_units=) were all removed, and no consumer survives in arrt/tools or anywhere else tracked, so the change conforms. 'When a comment names a symbol as the source of truth for a set, parametrise the test over that symbol': test_settings.py parametrises over SETTINGS, and the .env.example root test derives its variables from the module and counts `Setting(` declarations against them, so it conforms. 'When you retire, amend, descope or close anything, first grep the whole repo': accessibility-spec's 'a Settings \u203a General control for it waits on the interface redesign' was replaced. museum-label-findings.md:81 still says 'the deployment's `LABEL_UNITS`'. That record is outside this change and still true where the environment sets it, so no edit is wanted. 'When you write a negative claim\u2026': fired once, in the finding above. No learnings rule was added or changed in this interval, and no implicit supersession was found.", "fid": "R-14"}, {"goal": "The System Can Be Understood", "severity": "note", "title": "Backlog Reconciliation: no open item covers the changed paths; #329 does not resolve, and #44 looks stale", "recommendation": "Scope none. `cache-query affecting <changed files>` returned 0 items (cache confirmed 5h old). C-B4: the change record's `closes: [brookstalley/arrt#329]` and plan Chunk 02 cite #329, and `resolve` reports 'no item in the cache claims that id'. Check whether #329 was closed ahead of the merge, or whether the id is wrong. Backlog item appears resolved: brookstalley/arrt#44 'curation: load_dotenv(override=True) makes .env beat the environment'. config.py now calls `load_dotenv()` without override, and the comment at line 573 records the change. That fix landed before this interval, but this branch's precedence rule (the environment locks the setting) depends on it. Verify it, then call `/prawduct:backlog update 44 status=shipped closed-by=<the scope that fixed it>` when the backlog skill's 'When to mark shipped' rule says.", "fid": "R-15"}, {"goal": "The System Can Be Understood", "severity": "note", "title": "Records Pass: all 8 oracle files covered, none clears a bar", "recommendation": "Scope none. Covered: accessibility-spec.md, agents-and-memory.md, api-contract.md, build-plan-unattended-settings.md, data-model.md, information-architecture.md, nonfunctional-requirements.md, changes/unattended-settings.md. Spot-checked against the code: NFR's 'An allowance stored above a budget since lowered reads as $0.00' (_state falls back to the default, so true); api-contract's SettingOut and UnattendedOut field lists (match models.py); data-model's StoredSetting table (matches the schema and record); the change record's Consumer note on LABEL_UNITS locking (true, because load_dotenv puts .env into os.environ). The plan's stale Chunk 03 key names and `may_start(estimate)` shape are folded into the mid-build-decisions note. Nothing found ships a false claim, misleads into a wrong action, or carries a wrong command. record_lint: every count is 0, nothing unchecked. priors: none.", "fid": "R-16"}], "counts": {"blocking": 0, "warning": 5, "note": 11}, "observations": [], "duration_seconds": 600, "scope": "unattended-settings", "scope_chosen_by": "binding", "scope_unresolved_cause": null, "scope_reason": null, "base_extended_from": null, "chunks": ["03"], "chunks_proposed": ["03"], "chunk": "03", "base_reviewed": "06a456f61babbd88be886fe73d347f30c0e83e90", "record_lint": {"records": [".prawduct/artifacts/accessibility-spec.md", ".prawduct/artifacts/agents-and-memory.md", ".prawduct/artifacts/api-contract.md", ".prawduct/artifacts/build-plan-unattended-settings.md", ".prawduct/artifacts/data-model.md", ".prawduct/artifacts/information-architecture.md", ".prawduct/artifacts/nonfunctional-requirements.md", ".prawduct/changes/unattended-settings.md"], "chunk_graded": "03", "chunks_graded": ["03"], "plan_graded": ".prawduct/artifacts/build-plan-unattended-settings.md", "findings": [], "unchecked": [], "counts": {"chunk-ref-missing": 0, "governed-by-gap": 0, "suite-total-claim": 0, "learnings-over-budget": 0, "learnings-budget-unreasoned": 0, "learnings-core-raise-unapproved": 0, "learnings-rule-too-long": 0, "learnings-rule-body": 0, "learnings-area-dead": 0, "change-fragment": 0, "retired-claim-s